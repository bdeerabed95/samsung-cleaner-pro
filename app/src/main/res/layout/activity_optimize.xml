<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F7">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F6F7"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/optimizeAnimation"
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:lottie_rawRes="@raw/scan_animation"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnOptimizeNow"
            android:text="تحسين الجهاز بالكامل"
            android:background="@drawable/clean_button_bg"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_width="250dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/optimizeResult"
            android:text="جاهز للتحسين"
            android:textSize="18sp"
            android:textColor="#333"
            android:padding="15dp"
            android:background="#E8F5E9"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
